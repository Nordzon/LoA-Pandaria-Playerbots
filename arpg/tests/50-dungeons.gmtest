# Dungeon scaling (m5 tasks 3.1-3.3, SPEC 4.6). Needs Arpgtest online. AutoBalance (on via write-confs) scales the
# instance; mod_arpg replaces its player-count curve: 5-man solo = 30% health / 40% damage, x0.75 damage for a non-tank.
# The hook records what it applied (event recorder).

> .arpg config set Arpg.Test.RecordEvents 1
? ok
> .arpg dungeon level Arpgtest 36 0
? ok dungeon level map=36 level=0
> .arpg test setup Arpgtest 90 deadmines-inside
? ok .*\(online\)
~ 12000
> .arpg dungeon info Arpgtest
? dungeon map=36 instance=1 raid=0 players=1 role=(damage|tank|healer) solo=1
> .arpg test events Arpgtest
? instance scale map=36 players=1 boss=0 health=0\.300 damage=0\.(300|400) tier=0 role=(0\.75|1\.00)

# Level selector: run the Deadmines at 20 (chosen outside, applied when the instance counts its players on entry).
> .arpg test setup Arpgtest 90 elwynn-northshire
? ok .*\(online\)
~ 8000
> .arpg dungeon level Arpgtest 36 20
? ok dungeon level map=36 level=20
> .arpg test events Arpgtest clear
? ok
> .arpg test setup Arpgtest 90 deadmines-inside
? ok .*\(online\)
~ 12000
> .arpg test events Arpgtest
? instance level map=36 level=20

> .arpg dungeon level Arpgtest 36 0
? ok

# --- Raids (BALANCE §6): solo raid row 10% health / 25% damage x the raid tier (Molten Core: tier 1, x1.15).
> .arpg test events Arpgtest clear
? ok
> .arpg test setup Arpgtest 90 molten-core-inside
? ok .*\(online\)
~ 15000
> .arpg dungeon info Arpgtest
? dungeon map=409 instance=1 raid=1 players=1 .* raid_tier=1
> .arpg test events Arpgtest
? instance scale map=409 players=1 boss=0 health=0\.115 damage=0\.28[78] tier=1 role=1\.00

# --- Ascended affix tiers (BALANCE §12): a raid drop rolls above T5 only with raid tier AND Paragon. Loot level 90 (the
# Vale: uncapped) = T5; boss loot rolls every affix at the cap, so the cap shows directly. Item 82437: epic robe (level 90).
> .arpg test setup Arpgtest 90 vale-krikthik
? ok .*\(online\)
~ 15000
> .arpg test clearbags Arpgtest
? ok
> .arpg paragon set Arpgtest 110 0
? ok
> .arpg test give Arpgtest 82437 boss 3671 raid 7
? quality=4 affixes=[3-5]
> .arpg loot last Arpgtest
? T8=
! T[1-7]=
# Paragon 59 in a tier-5 raid: T7 needs Paragon 60 -> T6.
> .arpg paragon set Arpgtest 59 0
? ok
> .arpg test give Arpgtest 82437 boss 3671 raid 5
? quality=4
> .arpg loot last Arpgtest
? T6=
! T[78]=
# No raid: T5 is the top.
> .arpg test give Arpgtest 82437 boss 3671
? quality=4
> .arpg loot last Arpgtest
? T5=
! T[678]=
> .arpg paragon set Arpgtest 0 0
? ok
> .arpg test clearbags Arpgtest
? ok

> .arpg test setup Arpgtest 20 elwynn-northshire
? ok .*\(online\)
~ 8000
> .arpg config set Arpg.Test.RecordEvents 0
? ok
