# Smoke test: server is up, SOAP works, our module is loaded.
> .server info
? uptime
? update time

# Added in change m1-module-skeleton
> .arpg version
? mod_arpg

# No random Champions during the test run (fixed spawn probes must stay plain); 30-champions ends with .arpg reload,
# which brings the conf value back for play.
> .arpg config set Arpg.Champion.Chance 0
? ok
> .arpg config set Arpg.Champion.Camps 0
? ok
# Monsters scale to exactly the player level during the run (the 2-4 below rule is tested in 65-trash-levels).
> .arpg config set Arpg.Scale.LevelBelowMin 0
? ok
> .arpg config set Arpg.Scale.LevelBelowMax 0
? ok
# The companion starts off (a leftover "on" from an earlier run would loot every test kill; 34 counts its corpses).
> .arpg lootpet off Arpgtest
? ok lootpet off

# Every creature entry fits the 20 bits a MoP creature GUID has for it (else the client shows nothing; 2026-11-26).
> .arpg test entries
? over_20bit=0\b
