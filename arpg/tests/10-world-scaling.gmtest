# World scaling (change m1-world-scaling). Uses the test character "Arpgtest", which must be online:
# the overnight pipeline creates it and holds it in the world with the headless client
# (contrib\headless-client\headless.py --cmd play --char <guid> --hold 420) while the tests run.
# Test spots live in arpg_test_spot (SQL). Probes use fixed spawns: Blackrock Spy 178359 (Northshire, level 1-2) and
# Defias Pillager 308244 (Westfall, 13-14) - "nearest" can be a wandering critter.

> .arpg version
? mod_arpg

# The sections below test the scaling rules without the zone cap (task 4.9), which is tested at the end.
> .arpg config set Arpg.Scale.ZoneCapAbove 100
? ok
# The probe creatures must stay plain: no Champion rolls during this file, and undo one that rolled before it.
> .arpg config set Arpg.Champion.Chance 0
? ok

# --- Level choices: low zone rises to the player's level ---------------------------------
> .arpg test setup Arpgtest 85 elwynn-northshire
? ok .*\(online\)
# teleport + grid load + one scaling tick (Arpg.Scale.TickMs)
~ 6000
> .arpg champion clear Arpgtest 178359
? ok
~ 3000
> .arpg scale probe Arpgtest 178359
? scaled=85\b

> .arpg test setup Arpgtest 30 elwynn-northshire
? ok .*\(online\)
~ 4000
> .arpg scale probe Arpgtest 178359
? scaled=30\b

> .arpg test setup Arpgtest 60 elwynn-northshire
? ok .*\(online\)
~ 4000
> .arpg scale probe Arpgtest 178359
? scaled=60\b

# --- Level offset (Arpg.Scale.LevelOffset) ----------------------------------------------
> .arpg config set Arpg.Scale.LevelOffset 2
? ok
~ 4000
> .arpg scale probe Arpgtest 178359
? scaled=62\b
> .arpg config set Arpg.Scale.LevelOffset -2
? ok
~ 4000
> .arpg scale probe Arpgtest 178359
? scaled=58\b

# Level cap: 90 + offset 5 is clamped to the server cap (90).
> .arpg config set Arpg.Scale.LevelOffset 5
? ok
> .arpg test setup Arpgtest 90 elwynn-northshire
? ok .*\(online\)
~ 4000
> .arpg scale probe Arpgtest 178359
? scaled=90\b
> .arpg config set Arpg.Scale.LevelOffset 0
? ok

# --- Upward only: Westfall mobs (10-18) keep their own level for a level-5 character ------
# (same continent on purpose: the far teleport to Pandaria sometimes leaves the headless client mid-transfer)
> .arpg test setup Arpgtest 5 westfall-sentinelhill
? ok .*\(online\)
~ 8000
> .arpg scale probe Arpgtest 308244
? scaled=none

# --- Bot lock (task 3.4): a creature fighting someone who is not a real player (a bot; here a summoned stand-in) keeps its
# level when the player's level changes; once out of combat it scales again.
> .arpg test setup Arpgtest 30 elwynn-northshire
? ok .*\(online\)
~ 6000
> .arpg scale probe Arpgtest 178359
? scaled=30\b
> .arpg scale combat Arpgtest 178359 on
? ok combat on spawn=178359 incombat=1
> .arpg test setup Arpgtest 60 elwynn-northshire
? ok .*\(online\)
~ 6000
> .arpg scale combat Arpgtest 178359 status
? incombat=1 victim=299\b
> .arpg scale probe Arpgtest 178359
? scaled=30\b
> .arpg scale combat Arpgtest 178359 off
? ok combat off
> .arpg scale probe Arpgtest 178359
* scaled=60\b

# --- Kill switch turns scaling off (and reverts what was scaled) -------------------------
> .arpg config set Arpg.Scale.Enabled 0
? ok
> .arpg test setup Arpgtest 85 elwynn-northshire
? ok .*\(online\)
~ 15000
> .arpg scale probe Arpgtest 178359
? scaled=none
> .arpg config set Arpg.Scale.Enabled 1
? ok

# --- Zone cap (task 4.9, owner 2026-11-22): monsters scale to at most zone max + 15 -------------
# Northshire's normal range is 1-5 (area 9 in arpg_zone_level), so a level-60 character meets level-20 monsters there.
> .arpg config set Arpg.Scale.ZoneCapAbove 15
? ok
> .arpg test setup Arpgtest 60 elwynn-northshire
? ok .*\(online\)
~ 10000
> .arpg scale probe Arpgtest 178359
? scaled=20\b

# Zones in Arpg.Scale.UncappedZones scale to any level (the Vale of Eternal Blossoms in play; Northshire here as a stand-in).
> .arpg config set Arpg.Scale.UncappedZones 5840,6170,9
? ok
~ 3000
> .arpg scale probe Arpgtest 178359
? scaled=60\b
> .arpg config set Arpg.Scale.UncappedZones 5840
? ok
> .arpg config set Arpg.Champion.Chance 2
? ok
