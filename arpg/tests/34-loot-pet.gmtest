# Loot companion (m2b tasks 3.1-3.4, 5.2; SPEC 4.7). Needs Arpgtest online. The pet queues the character's kills and,
# out of combat, walks to each corpse and moves its gold and items into the bags (core store path: affixes, loot filter).

> .arpg test setup Arpgtest 20 elwynn-northshire
? ok .*\(online\)
> .arpg test clearbags Arpgtest
? ok
> .arpg config set Arpg.Test.RecordEvents 1
? ok
> .arpg filter reset Arpgtest
? ok|filter
> .arpg lootpet on Arpgtest
? ok lootpet on
~ 2000
> .arpg lootpet info Arpgtest
? lootpet on pet=[1-9]\d* queue=0

# Three kills (Kobold Vermin: always carry gold, so no corpse is empty): the pet empties all three.
> .arpg test events Arpgtest clear
? ok
> .arpg test pack Arpgtest 6 3 kill loot
? killed=3
~ 12000
> .arpg lootpet info Arpgtest
? lootpet on pet=[1-9]\d* queue=0 looted=3
> .arpg test events Arpgtest
? lootpet looted corpse=6 items=\d+ gold=[1-9]\d*

# Companion roles (Arpg.Companion.*): gossip + vendor + repair + bank + mailbox + reforge + transmog + void = 0x3C021081.
> .arpg lootpet info Arpgtest
? npcflags=0x3C021081\b
# Full bags: the companion mails what doesn't fit (affixes rolled first). A Champion's floor = a green + a blue.
> .arpg test fillbags Arpgtest 25
? ok Arpgtest filled=[1-9]\d*
> .arpg config set Arpg.Champion.LootBlueChance 100
? ok
> .arpg champion make Arpgtest 49871
? ok
> .arpg test events Arpgtest clear
? ok
# "all": the minions die too, so the fight is over and the pet goes.
> .arpg champion kill Arpgtest all
? ok .* killed champion
~ 12000
> .arpg test events Arpgtest
? lootpet mailed items=[1-9]
> .arpg config set Arpg.Champion.LootBlueChance 25
? ok
> .arpg test clearbags Arpgtest
? ok

# In combat they're cleared (Arpg.Companion.InCombat 0), and back afterwards.
> .arpg test pack Arpgtest 49871 1 aggro
? spawned=1
~ 2500
> .arpg lootpet info Arpgtest
? npcflags=0x0\b
> .arpg test pack Arpgtest 49871 1 kill
? killed=1

# Off: the pet goes away.
> .arpg lootpet off Arpgtest
? ok lootpet off
~ 2000
> .arpg lootpet info Arpgtest
? lootpet off pet=0
> .arpg config set Arpg.Test.RecordEvents 0
? ok
