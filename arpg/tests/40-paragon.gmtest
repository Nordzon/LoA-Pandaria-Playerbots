# Paragon (m4 tasks 3.1/3.4, SPEC 4.5). Needs Arpgtest online. At the max level XP becomes Paragon XP; the curve is
# XpBase 600000 x XpGrowth 1.04^level; one point per level in rotation Core -> Offense -> Defense -> Utility.

> .arpg test setup Arpgtest 90 elwynn-northshire
? ok .*\(online\)
> .arpg paragon set Arpgtest 0 0
? ok paragon level=0 xp=0/600000 points core=0 offense=0 defense=0 utility=0

# 650000 XP at 90: level 1 (600000) + 50000 into level 1 (next needs 624000).
> .arpg paragon xp Arpgtest 650000
? ok paragon level=1 xp=50000/624000 points core=1 offense=0 defense=0 utility=0

# 2000000 more carries over three levels: 624000 + 648960 + 674918 -> level 4 with 102122 left.
> .arpg paragon xp Arpgtest 2000000
? ok paragon level=4 xp=102122/701915 points core=1 offense=1 defense=1 utility=1

# Below the max level XP stays normal XP (no Paragon).
> .arpg test setup Arpgtest 20 elwynn-northshire
? ok .*\(online\)
> .arpg paragon xp Arpgtest 1000
? ok paragon level=4 xp=102122/

# --- Points (owner: Diablo 3 rotation, free respec). Paragon 8 = 2 points in every tab.
> .arpg test setup Arpgtest 90 elwynn-northshire
? ok .*\(online\)
> .arpg test clearbags Arpgtest
? ok
> .arpg paragon set Arpgtest 8 0
? ok paragon level=8 .* points core=2 offense=2 defense=2 utility=2
> .arpg paragon respec Arpgtest
? ok respec

# Core: 2 points in stamina = +1% stamina (a naked level-90 test character has ~190 stamina: +1-2 measured, 1% applied).
> .arpg paragon spend Arpgtest core stamina 2
? ok spent tab=0 stat=1 points=2 before=\d+ after=\d+ diff=[12] .* stamina_pct=1\.0
# The tab has no points left.
> .arpg paragon spend Arpgtest core agility 1
? not enough points: tab has 0 unspent

# Offense: 2 points in crit = +480 crit rating exactly.
> .arpg paragon spend Arpgtest offense crit 2
? ok spent tab=1 stat=0 points=2 .* diff=480\b

# The ArpgUI addon's data line: level|xp|next|unspent per tab|points per stat|rule numbers.
> .arpg paragon data Arpgtest
? ARPGP\|8\|0\|\d+\|0,0,2,2\|0,2,0,0\|2,0,0\|0,0,0\|0,0,0\|0\.50,240,0\.40,100,1000,500,10000

# Utility: 2 points in move speed = +2% above the affix cap.
> .arpg paragon spend Arpgtest utility speed 2
? ok spent tab=3 stat=0 points=2 .* move=200\b
~ 2000
> .arpg loot effects Arpgtest
? aura_move_speed_pct=2\b

# Free respec: everything back.
> .arpg paragon respec Arpgtest
? ok respec .* stamina_pct=0\.0 crit=0 .* move=0\b
~ 2000
> .arpg loot effects Arpgtest
! aura_move_speed_pct=[1-9]

# --- World tier (the Vale, uncapped): +2% monster health/damage per Paragon level (cap +100%). The scaling tick re-scales
# level-90 Vale mobs near the character; the event recorder shows the tier (mobs already fighting NPCs are left alone,
# so no single fixed probe).
> .arpg paragon respec Arpgtest
? ok respec
> .arpg config set Arpg.Test.RecordEvents 1
? ok
> .arpg test setup Arpgtest 90 vale-krikthik
? ok .*\(online\)
# far teleport (Pandaria): give the client time to arrive
~ 15000
> .arpg paragon set Arpgtest 10 0
? ok paragon level=10
> .arpg test events Arpgtest clear
? ok
~ 4000
> .arpg test events Arpgtest
* scale entry=\d+ spawn=\d+ from=90 to=90 hp=\d+ tier=120\b
> .arpg paragon set Arpgtest 80 0
? ok paragon level=80
> .arpg test events Arpgtest clear
? ok
~ 4000
> .arpg test events Arpgtest
* scale entry=\d+ spawn=\d+ from=90 to=90 hp=\d+ tier=200\b
> .arpg config set Arpg.Test.RecordEvents 0
? ok
> .arpg paragon set Arpgtest 0 0
? ok paragon level=0
> .arpg test setup Arpgtest 20 elwynn-northshire
? ok .*\(online\)
~ 6000
