# Superuniques (m3 tasks 3.4/4.2, BALANCE §14). Needs Arpgtest online. Elwynn Forest (zone 12) has a pool of 5; the zone keeps
# one alive while a real player is in it. Level 20: band 15 (+2 levels, 4x health, 1.35x damage, 3 abilities, 40% orb).
# Rules, not rates: the respawn delay is set to 5 s, a Superunique is spawned next to the character, the Unique pity is full.

> .arpg test setup Arpgtest 20 elwynn-wilds
? ok .*\(online\)
> .arpg test clearbags Arpgtest
? ok
> .arpg config set Arpg.Test.RecordEvents 1
? ok
> .arpg config set Arpg.Superunique.RespawnDelay 5
? ok
~ 2500

# The zone has one alive (somewhere at one of its points). A bot may just have killed it: skip the delay first.
> .arpg superunique next Arpgtest
? ok
~ 2500
> .arpg superunique info Arpgtest
? superunique zone=12 pool=5 alive=1 \[id=[1-5] entry=\d+ abilities=3

# Morgaine the Sly (id 1, caster kit) next to the character, replacing the live one.
> .arpg superunique spawn Arpgtest 1
? ok Arpgtest superunique id=1 entry=99 level=22 band=15 hp=\d+ abilities=3
> .arpg superunique info Arpgtest
? alive=1 \[id=1 entry=99 abilities=3 level=22
# The zone is told (m3 3.4).
> .arpg test events Arpgtest
? superunique announce .*Morgaine the Sly.* stalks

# Fight: her abilities go at whoever holds her aggro (here the character: threat set by "fight"; Goldshire guards may have
# drawn her abilities in town - so this test stands in the wilds) and hit for a % of the target's max health.
> .arpg test events Arpgtest clear
? ok
> .arpg superunique fight Arpgtest
? in_combat=1
~ 6000
> .arpg test events Arpgtest
? superunique ability spell=\d+ kind=[012] casting=[01] target=me
? superunique hit spell=\d+ dmg=[1-9]

# Kill with full Unique pity: 40% orb (from 50% health), a guaranteed blue, a Unique base in the loot.
# Her hits may have killed the character during the 6 s above (a dead character gets no orb): bring it back first.
> .revive Arpgtest
> .arpg pity set Arpgtest unique 99 18
? ok unique_misses boss=99 = 18
> .arpg test events Arpgtest clear
? ok
> .arpg superunique kill Arpgtest
? ok Arpgtest killed superunique entry=99 health_pct=([89]\d|100) loot_items=([2-9]|\d\d)
> .arpg test events Arpgtest
? superunique killed id=1 entry=99 tag=Unique Morgaine the Sly orb_health=[1-9]\d* floor_blue=[1-9]\d* unique won misses=0 unique_base=[1-9]
# The Unique is decided at the kill: the loot window already shows "<base> - <Unique name>" (suffix 31000 + unique id).
# Her own Unique (arpg_superunique_unique): Twin Fangs of Venomspite (3).
? loot plan item=\d+ rp=-31003 n=[1-4] unique=3
> .arpg superunique loot Arpgtest
? ok Arpgtest looted=([2-9]|\d\d)
> .arpg test events Arpgtest
? affix item=\d+ .*unique=3 "Twin Fangs of Venomspite"

# Rotation: 5 s later a DIFFERENT Superunique of the zone spawns.
> .arpg superunique info Arpgtest
? alive=0 respawn_in=[0-5] last_killed=1
~ 7000
> .arpg superunique info Arpgtest
? alive=1 \[id=[2-5] entry=

> .arpg pity set Arpgtest unique 99 0
? ok
> .arpg config set Arpg.Superunique.RespawnDelay 300
? ok
> .arpg config set Arpg.Test.RecordEvents 0
? ok

# --- The whole world (owner 2026-11-27, gen_superuniques.py): every open-world zone has a pool of its own rares. In the Jade
# Forest (5785, 8 rares) the pool is loaded and one of them spawns.
> .arpg test setup Arpgtest 85 jadeforest-dawnsblossom
? ok .*\(online\)
# far teleport (Pandaria): give the client time to arrive, then the zone tick spawns one
~ 15000
# (Bots questing there may have killed the zone's one already - it then waits out the respawn delay - so spawn one now.)
> .arpg superunique info Arpgtest
? superunique zone=5785 pool=8 
> .arpg superunique spawn Arpgtest
? ok
> .arpg superunique info Arpgtest
? zone=5785 pool=8 alive=1
> .arpg superunique kill Arpgtest
? ok
> .arpg test setup Arpgtest 20 elwynn-northshire
? ok .*\(online\)
~ 6000
